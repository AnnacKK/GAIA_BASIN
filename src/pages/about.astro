      body {
        background-color: #0e1a2f; /* Dark navy base background matching Hero mockup */
        color: var(--text-main);
        font-family: 'Inter', sans-serif;
        margin: 0;
        overflow-x: hidden;
        transition: background-color 0.4s ease-out;
      }
      
      h1, h2, h3, h4, .gothic-serif {
        font-family: 'Playfair Display', serif;
      }
      
      /* Balatro Background Container */
      #balatro-container {
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        z-index: -1;
      }
      
      /* Scroll animations */
      .reveal-up {
        opacity: 0;
        transform: translateY(40px);
        transition: all 1s cubic-bezier(0.16, 1, 0.3, 1);
      }
      
      .reveal-up.is-visible {
        opacity: 1;
        transform: translateY(0);
      }
      
      /* Webflow-style smooth scrolling */
