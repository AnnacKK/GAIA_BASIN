    <script>
      // Intersection Observer for scroll animations
      document.addEventListener('DOMContentLoaded', () => {
        const observerOptions = {
          root: null,
          rootMargin: '0px',
          threshold: 0.15
        };

        const observer = new IntersectionObserver((entries, observer) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target); // Run once
            }
          });
        }, observerOptions);

        document.querySelectorAll('.reveal-up').forEach(element => {
          observer.observe(element);
        });
      });
    </script>
    <!-- Scroll-driven node zoom and pointer-follower transition script -->
    <script>
      document.addEventListener('DOMContentLoaded', () => {
        const parentNode = document.getElementById('svg-parent-node');
        const expandingCircle = document.getElementById('hero-expanding-circle');
        const projectsSection = document.getElementById('projects');
        const projectsBg = document.getElementById('projects-bg');
        const aboutSection = document.getElementById('about');

        if (!parentNode || !expandingCircle || !projectsSection) return;

        let mouseX = 0, mouseY = 0;
        let followerX = 0, followerY = 0;
        let isHoveringProjects = false;

        // Global window-level mouse coordinate tracking
        window.addEventListener('mousemove', (e) => {
          mouseX = e.clientX;
          mouseY = e.clientY;
        });

        // Hover toggles on the Projects section
        projectsSection.addEventListener('mouseenter', () => {
          isHoveringProjects = true;
          // Instantly sync follower position on enter to prevent laggy drag-in
          followerX = mouseX;
          followerY = mouseY;
        });

        projectsSection.addEventListener('mouseleave', () => {
          isHoveringProjects = false;
        });

        function updateLoop() {
          requestAnimationFrame(updateLoop);

          const scrollY = window.scrollY;
          const viewportHeight = window.innerHeight;

          // Expand progress (Hero to About transition)
          const progressExpand = Math.min(scrollY / (viewportHeight * 0.95), 1);
          let progressShrink = 0;

          if (scrollY > viewportHeight * 0.95) {
            progressShrink = Math.min((scrollY - viewportHeight * 0.95) / (viewportHeight * 0.8), 1);
          }

          // Only trigger mouse-following cursor if we have scrolled past the About section
          const isScrollInProjects = scrollY > (viewportHeight * 1.3) || progressShrink >= 0.95;

          if (isHoveringProjects && isScrollInProjects) {
            // Smooth pointer following
            followerX += (mouseX - followerX) * 0.15;
            followerY += (mouseY - followerY) * 0.15;

            expandingCircle.style.left = `${followerX}px`;
            expandingCircle.style.top = `${followerY}px`;
            expandingCircle.style.opacity = '1';
            expandingCircle.style.transform = 'translate(-50%, -50%) scale(0.25)';
            expandingCircle.style.backgroundColor = '#ff4d3d';
            expandingCircle.style.boxShadow = '0 0 20px #ff4d3d, 0 0 40px #ff4d3d';
            if (projectsBg) projectsBg.style.opacity = '1';
            return;
          } else {
            expandingCircle.style.boxShadow = 'none';
          }

          if (scrollY > viewportHeight * 0.95) {
            // Phase 2: Shrink circle as we scroll further down towards projects
            const maxScale = 66;
            const minScale = 0.25;
            const scale = maxScale - progressShrink * (maxScale - minScale);

            // Anchor to center of viewport during shrinking
            expandingCircle.style.left = '50%';
            expandingCircle.style.top = '50%';
            expandingCircle.style.opacity = progressShrink > 0.95 ? '0' : '1';
            expandingCircle.style.transform = `translate(-50%, -50%) scale(${scale})`;
            expandingCircle.style.backgroundColor = '#630511';
          } else if (progressExpand > 0.01) {
            // Phase 1: Expand circle
            const rect = parentNode.getBoundingClientRect();
            const parentCenterX = rect.left + rect.width / 2;
            const parentCenterY = rect.top + rect.height / 2;

            expandingCircle.style.left = `${parentCenterX}px`;
            expandingCircle.style.top = `${parentCenterY}px`;
            expandingCircle.style.opacity = '1';

            if (progressExpand >= 0.5) {
              expandingCircle.style.backgroundColor = '#630511';
            } else {
              expandingCircle.style.backgroundColor = '#ff4d3d';
            }

            const scale = 1 + Math.pow(progressExpand, 3.5) * 65;
            expandingCircle.style.transform = `translate(-50%, -50%) scale(${scale})`;
          } else {
            // Hidden at top
            expandingCircle.style.opacity = '0';
            expandingCircle.style.transform = 'translate(-50%, -50%) scale(1)';
            expandingCircle.style.backgroundColor = '#ff4d3d';
          }

          // Dynamically fade in the Projects black background in sync with shrink progress
          if (projectsBg) {
            projectsBg.style.opacity = progressShrink.toString();
          }

          // Dynamically fade the About section background to black in sync with shrink progress
          if (aboutSection) {
            if (progressShrink > 0.01) {
              aboutSection.style.backgroundColor = `rgba(7, 5, 3, ${progressShrink})`;
            } else {
              aboutSection.style.backgroundColor = 'transparent';
            }
          }

          // Transition body background color smoothly
          if (progressShrink > 0.1) {
            // Fade body background to projects black as circle shrinks
            document.body.style.backgroundColor = '#070503';
          } else if (progressExpand >= 0.75) {
            document.body.style.backgroundColor = '#630511';
          } else {
            document.body.style.backgroundColor = '#0e1a2f';
          }
        }

        updateLoop();
      });
    </script>
  </body>
</html>
