      <style>
        /* ScrollVelocity Styles */
        .parallax-container {
          position: relative;
          overflow: hidden;
          width: 100%;
          display: flex;
        }
        .scroller-inner {
          display: flex;
          white-space: nowrap;
          will-change: transform;
        }
        .velocity-span {
          flex-shrink: 0;
          display: inline-block;
        }
      </style> <script>
        document.addEventListener('DOMContentLoaded', () => {
          const containers = document.querySelectorAll('.parallax-container');
          if (!containers.length) return;

          let lastScrollY = window.scrollY;
          let speed = 1.0;
          let baseSpeeds = Array.from(containers, (c) => parseFloat(c.getAttribute('data-direction')) * 1.5);
          let positions = Array(containers.length).fill(0);

          const inners = Array.from(containers, c => c.querySelector('.scroller-inner'));
          const spans = Array.from(containers, c => c.querySelector('.velocity-span'));
          
          function animate() {
            const scrollY = window.scrollY;
            const delta = scrollY - lastScrollY;
            lastScrollY = scrollY;

            // Increase velocity based on scroll delta
            const velocityFactor = Math.abs(delta) * 0.15;
            speed += (velocityFactor - speed) * 0.1;

            inners.forEach((inner, i) => {
              if (!spans[i] || !inner) return;
              const spanWidth = spans[i].offsetWidth;
              if (!spanWidth) return;
              
              const direction = baseSpeeds[i] > 0 ? 1 : -1;
              const increment = baseSpeeds[i] + direction * baseSpeeds[i] * speed;
              positions[i] += increment;

              // Wrap calculations
              if (direction > 0) {
                if (positions[i] > 0) positions[i] = -spanWidth;
              } else {
                if (positions[i] < -spanWidth) positions[i] = 0;
              }

              inner.style.transform = `translate3d(${positions[i]}px, 0, 0)`;
            });

            // Decelerate speed smoothly
            speed *= 0.95;
            if (speed < 0.01) speed = 0;

            requestAnimationFrame(animate);
          }

        });
      </script>




    <!-- Scroll-driven node zoom transition script -->
    <script>
      document.addEventListener('DOMContentLoaded', () => {
        const parentNode = document.getElementById('svg-parent-node');
        const expandingCircle = document.getElementById('hero-expanding-circle');

        function updateCircle() {
          if (!parentNode || !expandingCircle) return;

          const scrollY = window.scrollY;
          const viewportHeight = window.innerHeight;
          const progress = Math.min(scrollY / (viewportHeight * 0.95), 1);

          if (progress > 0.01) {
            // Find parent node coordinates in fixed viewport space
            const rect = parentNode.getBoundingClientRect();
            const parentCenterX = rect.left + rect.width / 2;
            const parentCenterY = rect.top + rect.height / 2;

            expandingCircle.style.left = `${parentCenterX}px`;
            expandingCircle.style.top = `${parentCenterY}px`;
            
            // Fade out slightly at the very end of scroll to blend into about section smoothly
            expandingCircle.style.opacity = progress > 0.98 ? '0' : '1';
            
            // Interpolate color from SVG parent node red (#ff4d3d) to target crimson (#630511)
            if (progress >= 0.5) {
              expandingCircle.style.backgroundColor = '#630511';
            } else {
              expandingCircle.style.backgroundColor = '#ff4d3d';
            }
            
            // Scale circle to cover full viewport width/height (no clipping because it is fixed!)
            const scale = 1 + Math.pow(progress, 3.5) * 65;
            expandingCircle.style.transform = `translate(-50%, -50%) scale(${scale})`;
          } else {
            expandingCircle.style.opacity = '0';
            expandingCircle.style.transform = 'translate(-50%, -50%) scale(1)';
            expandingCircle.style.backgroundColor = '#ff4d3d';
          }

          // Transition document body background to matching crimson background
          if (progress >= 0.75) {
            document.body.style.backgroundColor = '#630511';
          } else {
            document.body.style.backgroundColor = '#0e1a2f';
          }
        }

        window.addEventListener('scroll', updateCircle, { passive: true });
        window.addEventListener('resize', updateCircle);
        // Initial call
        setTimeout(updateCircle, 100);
      });
    </script>




