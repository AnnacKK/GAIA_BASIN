          </div>
          <button onclick="window.closeResourceAdder()" class="rounded-2xl border border-[#2b4d7b] bg-[#0d2a53] px-4 py-2 text-sm text-slate-100 hover:bg-[#1c4a82]">Cancel</button>
        </div>
        <div class="space-y-4 px-6 py-5">
          <label class="block text-sm font-medium text-slate-300">Resource type</label>
          <select id="resource-type" class="w-full rounded-3xl border border-[#1f2f4f] bg-[#071625] px-4 py-3 text-slate-100 focus:border-[#5c7aff] outline-none appearance-none">
            <option value="article">Article</option>
