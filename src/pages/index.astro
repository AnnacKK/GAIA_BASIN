          <aside class="rounded-[32px] border border-[#10243e] bg-[#051b31] p-5 text-sm text-slate-200 flex flex-col max-h-[calc(100vh-160px)]">
            <p class="text-xs uppercase tracking-[0.3em] text-[#7c98d9] mb-4 shrink-0">Interactive Graph</p>
