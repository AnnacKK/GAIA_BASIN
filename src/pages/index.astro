        const miniEdgesFiltered = miniEdges.filter(edge => selectedNeighborSet.has(edge.neighborId));
        const miniNodes = mainNodes
  .filter(node => node.id === nodeId || selectedNeighborSet.has(node.id))
  .map((node, index, array) => {
