          }).join('');
          return `<div>
            <p class="mb-4 text-xs uppercase tracking-[0.24em] text-[#7c98d9]">${section.title}</p>
            <nav class="line-sidebar line-sidebar--markers line-sidebar--ticks line-sidebar--scale-tick">
