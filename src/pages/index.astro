---
const GITHUB_TOKEN = import.meta.env.GITHUB_TOKEN;
const REPO_USER = "AnnacKK";
const REPO_NAME = "GAIA_BASIN_NOTES";
const REPO_BRANCH = "main";
const RAW_CDN_URL = `https://raw.githubusercontent.com/${REPO_USER}/${REPO_NAME}/${REPO_BRANCH}/`;

let processedNodes = [];
let processedLinks = [];
let folderTree = { id: 'root', label: 'Vault', children: [], files: [] };
let allResources = [];
let syncStatus = "Ready";

try {
  const headers = { "Accept": "application/vnd.github.v3+json", "Cache-Control": "no-cache" };
  if (GITHUB_TOKEN) headers["Authorization"] = `token ${GITHUB_TOKEN}`;

  const response = await fetch(`https://api.github.com/repos/${REPO_USER}/${REPO_NAME}/git/trees/${REPO_BRANCH}?recursive=1&t=${Date.now()}`, { headers });
  if (!response.ok) throw new Error(`API error: ${response.status}`);

  const data = await response.json();
  const folderMap = new Map();

  const ensureFolder = (segments) => {
    let current = folderTree;
    let path = "";
    for (const segment of segments) {
      path = path ? `${path}/${segment}` : segment;
      if (!folderMap.has(path)) {
        const next = { id: path, label: segment, children: [], files: [] };
        folderMap.set(path, next);
        current.children.push(next);
      }
      current = folderMap.get(path);
    }
    return current;
  };

  const fileNodes = data.tree
    .filter(item => item.type === 'blob' && item.path.toLowerCase().endsWith('.md'))
    .map(item => {
      const segments = item.path.split('/');
      const fileName = segments.pop().replace(/\.md$/i, '');
      const parent = ensureFolder(segments);
      parent.files.push({ id: item.path, label: fileName, type: 'file' });
      return {
        id: item.path,
        label: fileName,
        isFolder: false,
        color: '#cbd5e1',
        shape: 'dot',
        size: 14,
        path: item.path
      };
    });
 
  const folderNodes = Array.from(folderMap.values()).map(folder => ({
    id: folder.id,
    label: folder.label,
    isFolder: true,
    color: '#f8fafc',
    shape: 'dot',
    size: 18,
    path: folder.id
  }));
 
  processedNodes = [
    { id: folderTree.id, label: folderTree.label, isFolder: true, color: '#f8fafc', shape: 'dot', size: 24, path: folderTree.id },
    ...folderNodes,
    ...fileNodes
  ];

  const buildLinks = (folder) => {
    for (const child of folder.children) {
      processedLinks.push({ from: folder.id, to: child.id });
      buildLinks(child);
    }
    for (const file of folder.files) {
      processedLinks.push({ from: folder.id, to: file.id });
    }
  };

  buildLinks(folderTree);

  const fetchPromises = fileNodes.map(async (file) => {
    try {
      const encodePath = file.path.split('/').map(encodeURIComponent).join('/');
      const res = await fetch(`${RAW_CDN_URL}${encodePath}?t=${Date.now()}`);
      if (!res.ok) return;
      const text = await res.text();
      const body = text.replace(/^---[\s\S]*?---\s*/, '');
      const lines = body.split(/\r?\n/);
      let currentRes = null;
      const cleanLine = (str) => str.replace(/^[\*\-\s]+/, '').trim();
      for (let line of lines) {
        const trimmed = line.trim();
        if (trimmed.startsWith('- type:') || trimmed.startsWith('* type:')) {
          if (currentRes && currentRes.author) allResources.push(currentRes);
          currentRes = { type: cleanLine(trimmed).replace('type:', '').trim(), fileId: file.id };
        } else if (currentRes) {
          if (trimmed.startsWith('title:')) currentRes.title = cleanLine(trimmed).replace('title:', '').replace(/["']/g, '').trim();
          if (trimmed.startsWith('url:')) currentRes.url = cleanLine(trimmed).replace('url:', '').replace(/["']/g, '').trim();
          if (trimmed.startsWith('author:')) currentRes.author = cleanLine(trimmed).replace('author:', '').replace(/["']/g, '').trim();
          if (trimmed.startsWith('incognito:')) currentRes.incognito = cleanLine(trimmed).replace('incognito:', '').replace(/["']/g, '').trim() === 'true';
        }
      }
      if (currentRes && currentRes.author) allResources.push(currentRes);
    } catch (e) {
    }
  });

  await Promise.all(fetchPromises);
} catch (e) {
  syncStatus = "Offline";
}

