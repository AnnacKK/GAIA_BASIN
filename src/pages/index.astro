          <svg class="w-4 h-4 text-slate-500 absolute left-3 top-2.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
        </div>
        <div>
          <div id="vault-structure-container">
            <p class="text-[11px] uppercase tracking-[0.35em] text-[#7c98d9] mb-4">Graphs</p>
            <ul id="vault-structure" class="space-y-4 text-sm text-slate-200"></ul>
          </div>
          <div id="search-results-container" class="hidden">
            <p class="text-[11px] uppercase tracking-[0.35em] text-[#7c98d9] mb-4">Search Results</p>
            <ul id="search-results-list" class="space-y-2 text-sm text-slate-200"></ul>
          </div>
        </div>
        <p class="mt-auto text-[11px] uppercase tracking-[0.35em] text-[#7c98d9]">GlobalGraph</p>
      </aside>

      <main class="relative overflow-hidden bg-[#04162c] p-6">
        <div class="absolute right-6 top-6 z-20" id="auth-controls"></div>
        <div class="rounded-[36px] border border-[#0f2c56] bg-[#051a33] shadow-[0_0_100px_rgba(0,0,0,0.45)] overflow-hidden h-full min-h-[calc(100vh-96px)]">
          <div id="graph-canvas" class="relative h-full w-full"></div>
        </div>
      </main>
    </div>

    <div id="delete-modal" class="hidden fixed inset-0 z-[100] flex items-center justify-center bg-black/80 backdrop-blur-sm transition-opacity">
      <div class="w-full max-w-md rounded-2xl border border-[#1b2f4f] bg-[#051a33] p-6 shadow-2xl">
        <h3 class="text-lg font-semibold text-rose-400 mb-2">Delete Resource</h3>
        <p class="text-sm text-slate-300 mb-6">Are you sure you want to permanently delete "<span id="delete-modal-title" class="text-white font-medium"></span>"? This action cannot be undone and will immediately remove the resource from the global repository without requiring a Pull Request.</p>
        <div class="flex justify-end gap-3">
          <button onclick="window.closeDeleteModal()" class="rounded-xl px-4 py-2 text-sm font-medium text-slate-300 hover:bg-[#0f2c56] transition-colors">Cancel</button>
          <button id="confirm-delete-btn" class="rounded-xl bg-rose-600 px-4 py-2 text-sm font-medium text-white hover:bg-rose-500 transition-colors">Yes, Delete</button>
        </div>
      </div>
    </div>

    <div id="auth-alert-modal" class="hidden fixed inset-0 z-[100] flex items-center justify-center bg-black/80 backdrop-blur-sm transition-opacity">
      <div class="w-full max-w-md rounded-2xl border border-[#1b2f4f] bg-[#051a33] p-6 shadow-2xl">
        <h3 class="text-lg font-semibold text-[#8ecae6] mb-2">Authentication Required</h3>
        <p id="auth-alert-message" class="text-sm text-slate-300 mb-6">You must be logged in to perform this action.</p>
        <div class="flex justify-end gap-3">
          <a href="/api/auth/login" class="rounded-xl bg-[#17548c] px-4 py-2 text-sm font-medium text-white hover:bg-[#1a66ab] transition-colors">Log In</a>
          <button onclick="document.getElementById('auth-alert-modal').classList.add('hidden')" class="rounded-xl px-4 py-2 text-sm font-medium text-slate-300 hover:bg-[#0f2c56] transition-colors">Close</button>
        </div>
      </div>
    </div>

    <div id="node-viewer" class="hidden fixed inset-0 z-50 bg-black/80 p-6">
      <div class="viewer-shell mx-auto max-w-7xl rounded-[36px] border border-[#1b2f4f] bg-[#041728] shadow-2xl">
        <div class="flex flex-col gap-4 border-b border-[#10243e] px-6 py-5 md:flex-row md:items-center md:justify-between">
          <div>
            <button id="reader-close-button" onclick="window.closeNodeViewer()" class="mb-3 inline-flex items-center gap-2 rounded-full border border-[#1b3e63] bg-[#07172d] px-4 py-2 text-sm text-slate-200 hover:bg-[#0b2c52]">
              ← Vault
            </button>
            <p id="reader-title" class="text-2xl font-semibold text-white">Select a note</p>
            <p id="reader-path" class="mt-1 text-sm text-slate-400"></p>
          </div>
          <div id="contrib-controls" class="flex flex-wrap gap-2"></div>
        </div>
        <div class="viewer-grid grid gap-4 p-6 lg:grid-cols-[280px_1fr_280px]">
          <aside class="rounded-[32px] border border-[#10243e] bg-[#051b31] p-5 text-sm text-slate-200 overflow-auto custom-scrollbar">
            <div class="grid grid-cols-1 gap-2">
              <button onclick="window.handleTab('overview')" class="nav-btn">Overview</button>
              <button onclick="window.handleTab('books')" class="nav-btn">Books</button>
              <button onclick="window.handleTab('articles')" class="nav-btn">Articles</button>
              <button onclick="window.handleTab('courses')" class="nav-btn">Courses</button>
              <button onclick="window.handleTab('credits')" class="nav-btn">Credits</button>
            </div>
          </aside>

          <article id="reader-body" class="prose prose-invert overflow-auto rounded-[32px] border border-[#10243e] bg-[#041826] p-6 text-slate-100 custom-scrollbar"></article>

          <aside class="rounded-[32px] border border-[#10243e] bg-[#051b31] p-5 text-sm text-slate-200 flex flex-col max-h-[calc(100vh-160px)]">
            <p class="text-xs uppercase tracking-[0.3em] text-[#7c98d9] mb-4 shrink-0">Interactive Graph</p>
            <div id="mini-graph" class="h-48 shrink-0 rounded-[28px] border border-[#123153] bg-[#041826] mb-4"></div>

            <div id="focus-info" class="hidden shrink-0"></div>
            <ul id="closest-list" class="hidden shrink-0"></ul>

            <div id="reader-sections" class="space-y-4 text-sm overflow-y-auto flex-1 min-h-0 pr-2 pb-6 custom-scrollbar text-slate-300"></div>
            
          </aside>
        </div>
      </div>
    </div>

    <div id="editor-modal" class="hidden fixed inset-0 z-60 bg-black/80 p-6 overflow-auto">
      <div class="mx-auto max-w-4xl rounded-[32px] border border-[#1e314e] bg-[#061525] shadow-2xl">
        <div class="flex flex-col gap-4 border-b border-[#17324b] px-6 py-5 md:flex-row md:items-center md:justify-between">
          <div>
            <p id="editor-title" class="text-2xl font-semibold text-white">Propose contribution</p>
            <p class="mt-1 text-sm text-slate-400" id="editor-subtitle">Edit this note and submit as a pull request.</p>
          </div>
          <button onclick="window.closeEditor()" class="rounded-2xl border border-[#2b4d7b] bg-[#0d2a53] px-4 py-2 text-sm text-slate-100 hover:bg-[#1c4a82]">Cancel</button>
        </div>
        <div class="space-y-4 px-6 py-5">
          <label class="block text-sm font-medium text-slate-300">File path</label>
          <input id="editor-path" type="text" class="w-full rounded-3xl border border-[#1f2f4f] bg-[#071625] px-4 py-3 text-slate-100 focus:border-[#5c7aff] outline-none" placeholder="books/new-book.md" />
          <label class="block text-sm font-medium text-slate-300">Commit message</label>
          <input id="editor-commit" type="text" class="w-full rounded-3xl border border-[#1f2f4f] bg-[#071625] px-4 py-3 text-slate-100 focus:border-[#5c7aff] outline-none" placeholder="Propose an update or new note" />
          <label class="block text-sm font-medium text-slate-300">Pull request description</label>
          <textarea id="editor-pr-body" rows="4" class="w-full rounded-3xl border border-[#1f2f4f] bg-[#071625] px-4 py-3 text-slate-100 focus:border-[#5c7aff] outline-none" placeholder="Describe the proposed changes and any context."></textarea>
          <label class="block text-sm font-medium text-slate-300">Markdown content</label>
          <textarea id="editor-content" rows="14" class="w-full rounded-3xl border border-[#1f2f4f] bg-[#071625] px-4 py-3 text-slate-100 font-mono text-sm focus:border-[#5c7aff] outline-none"></textarea>
          <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
