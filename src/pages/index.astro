<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>GaiaBasin Garden</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <script src="https://cdn.jsdelivr.net/npm/vis-network@10.1.0/standalone/umd/vis-network.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/fuse.js@7.0.0"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>
    <style>
      html, body { background-color: #071621; color: #e7edf8; margin: 0; padding: 0; min-height: 100%; }
      body { font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; }
      .sidebar-scroll { overflow-y: auto; }
      .graph-panel { min-height: 24rem; }
      #vault-structure { list-style: none; margin: 0; padding: 0; }
      #vault-structure li { list-style: none; }
      .folder-label { display: flex; align-items: center; justify-content: space-between; gap: 0.75rem; padding: 0.75rem 0.85rem; border-radius: 1.25rem; transition: background 0.2s, color 0.2s; cursor: pointer; }
      .folder-label:hover { background: rgba(255, 255, 255, 0.05); }
      .folder-arrow { transition: transform 0.2s ease; }
      .folder-open > .folder-label .folder-arrow { transform: rotate(90deg); }
      .file-item { display: block; padding: 0.6rem 0.85rem; color: #a8c2e8; border-radius: 1.1rem; transition: background 0.2s, color 0.2s; cursor: pointer; }
      .file-item:hover { background: rgba(255, 255, 255, 0.04); color: #ffffff; }
      .prose pre { white-space: pre-wrap; word-break: break-word; overflow-wrap: anywhere; overflow-x: hidden; }
      .prose code { background: rgba(148, 163, 184, 0.12); padding: 0.2rem 0.35rem; border-radius: 0.35rem; word-break: break-word; overflow-wrap: anywhere; }
      #graph-canvas { position: absolute; inset: 0;z-index: 1; background: radial-gradient(circle at 20% 20%, rgba(87, 155, 255, 0.14), transparent 20%), linear-gradient(135deg, rgba(10, 22, 46, 0.96), rgba(4, 15, 29, 0.96), rgba(4, 15, 29, 0.96)); }
      #node-viewer { overflow: hidden; padding: 0; }

      #node-viewer .viewer-shell { width: 100vw; height: 100vh; max-width: none; max-height: none; overflow: hidden; border-radius: 0; }
      #node-viewer .viewer-shell > .flex { padding: 1.5rem; }
      #node-viewer .viewer-grid { min-height: 0; height: calc(100vh - 10rem); overflow: hidden; display: grid; gap: 1rem; grid-template-columns: minmax(100px, 150px) minmax(0, 1fr) minmax(260px, 320px); }
      #reader-body { overflow: auto; min-height: 0; max-height: 100%; }
      #reader-sections button, #reader-sections a { display: block; text-align: left; width: 100%; }
      #reader-sections li { list-style: none; }
      #reader-sections .section-item { padding: 0.55rem 0.75rem; border-radius: 1rem; transition: background 0.2s; }
      #reader-sections .section-item:hover { background: rgba(255,255,255,0.05); }
      #mini-graph { position: relative; overflow: hidden; }
      #mini-graph canvas { width: 100% !important; height: 100% !important; }

      .nav-btn {
  display: block;
  width: 100%;
  text-align: left;
  padding: 0.75rem 1rem;
  border-radius: 1rem;
  color: #94a3b8;
  transition: all 0.2s;
}
.nav-btn:hover {
  background: rgba(255, 255, 255, 0.05);
  color: #ffffff;
}

.scrollbar-hide::-webkit-scrollbar { display: none; }
.scrollbar-hide { -ms-overflow-style: none; scrollbar-width: none; }

/* ─── Celebration Animation ───────────────────────── */
@keyframes confetti-fall {
  0%   { transform: translateY(-20px) rotate(0deg) scale(1);   opacity: 1; }
  80%  { opacity: 1; }
  100% { transform: translateY(110vh) rotate(720deg) scale(0.4); opacity: 0; }
}
@keyframes confetti-sway {
  0%, 100% { margin-left: 0; }
  25%       { margin-left: 40px; }
  75%       { margin-left: -40px; }
}
@keyframes celebrate-pop {
  0%   { transform: scale(0.5) translateY(20px); opacity: 0; }
  60%  { transform: scale(1.05) translateY(-4px); opacity: 1; }
  100% { transform: scale(1) translateY(0); opacity: 1; }
}
@keyframes celebrate-float {
  0%, 100% { transform: translateY(0); }
  50%       { transform: translateY(-8px); }
}
.confetti-piece {
  position: fixed;
  width: 10px;
  height: 10px;
  border-radius: 2px;
  animation: confetti-fall linear forwards, confetti-sway ease-in-out infinite;
  pointer-events: none;
  z-index: 9999;
}

.custom-scrollbar::-webkit-scrollbar { width: 6px; height: 6px; }
.custom-scrollbar::-webkit-scrollbar-track { background: transparent; }
.custom-scrollbar::-webkit-scrollbar-thumb { background: #1b3e63; border-radius: 10px; }
.custom-scrollbar::-webkit-scrollbar-thumb:hover { background: #2b74b0; }
.custom-scrollbar { scrollbar-width: thin; scrollbar-color: #1b3e63 transparent; }
</style>
<style is:global>
.line-sidebar {
  --accent-color: #8ecae6;
  --text-color: #cbd5e1;
  --marker-color: #1e3a8a;
  --marker-length: 30px;
  --marker-gap: 8px;
  --tick-scale: 0.5;
  --max-shift: 10px;
  --item-gap: 6px;
  --font-size: 0.85rem;
  --smoothing: 150ms;

  position: relative;
  display: flex;
  justify-content: flex-start;
}

.line-sidebar--markers {
  padding-left: calc(var(--marker-length) + var(--marker-gap));
}

.line-sidebar--nested {
  padding-left: 20px;
  --marker-length: 12px;
}

.line-sidebar__list {
  list-style: none;
  margin: 0;
  padding: 0;
  display: flex;
  flex-direction: column;
  gap: var(--item-gap);
  width: 100%;
}

.line-sidebar__item {
  position: relative;
  cursor: pointer;
}

.line-sidebar__item::before {
  content: '';
  position: absolute;
  inset: -6px -48px;
  z-index: 1;
}

.line-sidebar__label {
  position: relative;
  display: flex;
  align-items: flex-start;
  font-size: var(--font-size);
  line-height: 1.2;
  color: color-mix(in srgb, var(--accent-color) calc(var(--effect, 0) * 100%), var(--text-color));
  transform: translateX(calc(var(--effect, 0) * var(--max-shift)));
  z-index: 2;
  transition: opacity 0.2s;
}

.line-sidebar__item:hover .line-sidebar__label {
  opacity: 1;
}

.line-sidebar__index {
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  margin-right: 0.6rem;
  font-size: 0.85em;
  opacity: calc(0.55 + var(--effect, 0) * 0.45);
  flex-shrink: 0;
  margin-top: 0.2rem;
}

.line-sidebar__text {
  flex: 1;
}

.line-sidebar__marker {
  position: absolute;
  top: 12px;
  left: calc(-1 * var(--marker-length) - var(--marker-gap));
  height: 2px;
  width: var(--marker-length);
  background-color: color-mix(in srgb, var(--accent-color) calc(var(--effect, 0) * 100%), var(--marker-color));
  transform-origin: left center;
  transform: translateY(-50%) scaleX(calc(0.5 + var(--effect, 0) * 0.5));
  z-index: 2;
  border-radius: 2px;
}

.line-sidebar--ticks .line-sidebar__item:not(:last-child)::after {
  content: '';
  position: absolute;
  top: 24px;
  left: calc(-1 * var(--marker-length) - var(--marker-gap));
  height: 2px;
  width: calc(var(--marker-length) * var(--tick-scale));
  background-color: var(--marker-color);
  opacity: 0.3;
  transform: translateY(-50%);
  border-radius: 2px;
}

.line-sidebar--scale-tick .line-sidebar__item:not(:last-child)::after {
  transform-origin: left center;
  transform: translateY(-50%) scaleX(calc(0.5 + var(--effect, 0) * 0.6));
}
</style>
  </head>
  <body>
    <div id="app-layout" class="grid h-screen grid-cols-[320px_1fr] bg-[#031226] transition-all duration-300">
      <aside id="left-sidebar" class="flex flex-col border-r border-[#0f1f42] bg-[#04112b] px-6 py-8 overflow-y-auto overflow-x-hidden custom-scrollbar transition-all duration-300 w-[320px]">
        
        <div class="mb-6 flex items-center gap-3">
          <div class="relative flex-1 group">
            <input type="text" id="vault-search" placeholder="Search notes..." class="w-full bg-[#051833] border border-[#14325a] rounded-xl py-2 pl-10 pr-10 text-sm text-slate-200 focus:outline-none focus:border-[#2b74b0] placeholder-slate-500" />
            <svg class="w-4 h-4 text-slate-500 absolute left-3 top-2.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
            <button id="clear-search-btn" class="absolute right-3 top-2.5 text-slate-500 hover:text-slate-300 hidden" title="Clear search" onclick="const input = document.getElementById('vault-search'); input.value=''; input.dispatchEvent(new Event('input'))">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
            </button>
          </div>
          <button onclick="window.toggleSidebar()" class="text-slate-400 hover:text-white transition-colors p-1 bg-[#0a1e3f] rounded-lg border border-[#14325a] hover:bg-[#12315e]" title="Close Sidebar">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 19l-7-7 7-7m8 14l-7-7 7-7"></path></svg>
          </button>
        </div>
        <div>
          <div id="vault-structure-container">
            <div class="flex items-center justify-between mb-4">
              <p class="text-[11px] uppercase tracking-[0.35em] text-[#7c98d9]">Graphs</p>
              <button onclick="window.fitGlobalGraph()" title="Zoom out and reset graph view" class="text-[10px] uppercase tracking-widest text-[#7c98d9] hover:text-white transition-colors duration-200 focus:outline-none bg-[#0a1e3f] hover:bg-[#12315e] border border-[#1a3866] px-2 py-1 rounded">Reset View</button>
            </div>
            <ul id="vault-structure" class="space-y-4 text-sm text-slate-200"></ul>
          </div>
          <div id="search-results-container" class="hidden">
            <p class="text-[11px] uppercase tracking-[0.35em] text-[#7c98d9] mb-4">Search Results</p>
            <ul id="search-results-list" class="space-y-2 text-sm text-slate-200"></ul>
          </div>
        </div>
        
        <div class="mt-auto pt-8 flex flex-col gap-4">
          <!-- Useful Researches Button -->
          <button onclick="window.openResearchesWindow()" class="flex items-center gap-3 text-sm text-[#8ecae6] hover:text-white transition-colors group px-0.5 mt-2">
            <svg class="w-4 h-4 opacity-70 group-hover:opacity-100" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"></path></svg>
            <span>Useful Researches</span>
          </button>

          <button onclick="document.getElementById('contribution-modal').classList.remove('hidden')" class="text-left text-[13px] font-medium text-slate-400 hover:text-[#8ecae6] transition-colors flex items-center gap-3">
             <svg class="w-4 h-4 opacity-70" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
             About Contribution
          </button>
          <a href="/about" class="text-left text-[13px] font-medium text-slate-400 hover:text-[#8ecae6] transition-colors flex items-center gap-3">
             <svg class="w-4 h-4 opacity-70" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>
             About Me
          </a>
        </div>
      </aside>

      <main class="relative overflow-hidden bg-[#04162c] flex-1">
        <div class="absolute top-6 left-6 z-50 flex items-center gap-4 pointer-events-none">
          <button id="open-sidebar-btn" onclick="window.toggleSidebar()" class="pointer-events-auto hidden bg-[#0d2a53] border border-[#2b4d7b] rounded-xl p-2.5 text-slate-300 hover:text-white hover:bg-[#1c4a82] shadow-lg transition-all" title="Open Sidebar">
             <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path></svg>
          </button>
          
          <!-- Live Graph Sync Status -->
          <div class="flex items-center gap-2.5 bg-[#0a1e3f]/80 backdrop-blur border border-[#14325a] px-4 py-2 rounded-xl shadow-lg pointer-events-auto">
            <span id="sync-status-dot" class="relative flex h-2 w-2 shrink-0">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-60"></span>
              <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
            </span>
            <div class="flex flex-col leading-none">
              <span class="text-[10px] font-semibold uppercase tracking-widest text-slate-400">Graph Sync</span>
              <span id="sync-status-time" class="text-[11px] text-slate-300 mt-0.5">Initializing…</span>
            </div>
          </div>
        </div>

        <div class="absolute right-6 top-6 z-20" id="auth-controls"></div>
        <div class="h-full w-full relative min-h-screen">
          <div id="graph-canvas" class="relative h-full w-full min-h-screen"></div>
          <!-- Live Graph Update Toast -->
          <div id="graph-sync-toast" class="hidden absolute bottom-24 left-1/2 -translate-x-1/2 z-50 flex items-center gap-2.5 bg-[#0a2336]/95 border border-[#1a4a7a] text-[#8ecae6] text-xs font-semibold px-5 py-2.5 rounded-full shadow-lg backdrop-blur-md transition-all duration-500 pointer-events-none">
            <svg class="w-3.5 h-3.5 text-emerald-400 animate-pulse" fill="currentColor" viewBox="0 0 20 20"><circle cx="10" cy="10" r="4"/></svg>
            <span id="graph-sync-toast-text">Graph updated with new content</span>
          </div>
          
          <!-- Bottom Centered Button Pill Group -->
          <div class="absolute bottom-8 left-1/2 -translate-x-1/2 z-30 flex items-center bg-[#05162a]/95 border border-[#14325a] rounded-full px-1.5 py-1.5 shadow-[0_12px_40px_rgba(0,0,0,0.6)] backdrop-blur-md">
            <button onclick="window.openAddNodeModal()" class="px-6 py-2.5 rounded-full text-sm font-semibold tracking-wider text-[#d5e9ff] hover:bg-[#12315e]/70 hover:text-white transition-all cursor-pointer">
              Add Node
            </button>
            <div class="h-6 w-px bg-[#14325a] mx-1"></div>
            <button onclick="window.openAddBranchModal()" class="px-6 py-2.5 rounded-full text-sm font-semibold tracking-wider text-[#d5e9ff] hover:bg-[#12315e]/70 hover:text-white transition-all cursor-pointer">
              Add Branch
            </button>
            <div class="h-6 w-px bg-[#14325a] mx-1"></div>
            <button onclick="window.openExportModal()" class="px-4 py-2.5 rounded-full text-sm font-semibold tracking-wider text-[#d5e9ff] hover:bg-[#12315e]/70 hover:text-white transition-all cursor-pointer flex items-center justify-center" title="Export Graph">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path></svg>
            </button>
          </div>
        </div>
      </main>
    </div>

    <!-- ─── Celebration Overlay ──────────────────────────────── -->
    <div id="celebrate-overlay" class="hidden fixed inset-0 z-[200] flex items-center justify-center pointer-events-none">
      <div id="celebrate-card" class="pointer-events-auto relative flex flex-col items-center gap-5 bg-[#040f20]/90 border border-[#1a4a7a]/60 backdrop-blur-xl rounded-3xl px-12 py-10 shadow-[0_0_80px_rgba(142,202,230,0.15)] text-center" style="animation: celebrate-pop 0.5s cubic-bezier(0.34,1.56,0.64,1) forwards; opacity:0;">
        <!-- Emoji salute burst -->
        <div style="animation: celebrate-float 2s ease-in-out infinite; font-size: 3.5rem; line-height:1;">🎉</div>
        <div>
          <p class="text-3xl font-extrabold text-white tracking-tight mb-1">Thank You!</p>
          <p class="text-base text-[#8ecae6] font-medium" id="celebrate-subtext">Your contribution is now under review.</p>
        </div>
        <div class="flex items-center gap-2 text-xs text-slate-400 bg-white/5 border border-white/10 rounded-full px-4 py-2">
          <svg class="w-3.5 h-3.5 text-emerald-400" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
          Pull request submitted to GitHub
        </div>
        <button onclick="window.closeCelebration()" class="mt-1 rounded-full bg-[#8ecae6]/10 hover:bg-[#8ecae6]/20 border border-[#8ecae6]/30 text-[#8ecae6] text-sm font-semibold px-8 py-2.5 transition-colors">Continue</button>
