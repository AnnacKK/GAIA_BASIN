            <button onclick="window.submitResource()" class="rounded-3xl bg-[#1a4f7f] px-5 py-3 text-sm font-semibold uppercase tracking-[0.18em] text-[#d5e9ff] hover:bg-[#2b74b0]">Submit resource</button>
