    </div>

    <div id="editor-modal" class="hidden fixed inset-0 z-60 bg-black/80 p-6 overflow-auto">
      <div class="mx-auto max-w-4xl rounded-[32px] border border-[#1e314e] bg-[#061525] shadow-2xl">
        <div class="flex flex-col gap-4 border-b border-[#17324b] px-6 py-5 md:flex-row md:items-center md:justify-between">
          <div>
            <p id="editor-title" class="text-2xl font-semibold text-white">Propose contribution</p>
            <p class="mt-1 text-sm text-slate-400" id="editor-subtitle">Edit this note and submit as a pull request.</p>
          </div>
          <button onclick="window.closeEditor()" class="rounded-2xl border border-[#2b4d7b] bg-[#0d2a53] px-4 py-2 text-sm text-slate-100 hover:bg-[#1c4a82]">Cancel</button>
        </div>
        <div class="space-y-4 px-6 py-5">
          <label class="block text-sm font-medium text-slate-300">File path</label>
