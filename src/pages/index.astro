---
import '../styles/custom.css';
import EditorModal from '../components/EditorModal.astro';
import ResourceModal from '../components/ResourceModal.astro';
import AddNodeModal from '../components/AddNodeModal.astro';
import ExportModal from '../components/ExportModal.astro';
import ResearchesWindow from '../components/ResearchesWindow.astro';
import AddResearchModal from '../components/AddResearchModal.astro';
import AddBranchModal from '../components/AddBranchModal.astro';
import AccountModal from '../components/AccountModal.astro';
import LibraryWindow from '../components/LibraryWindow.astro';
import AuthWarningModal from '../components/AuthWarningModal.astro';
import DeleteModal from '../components/DeleteModal.astro';
import RevertModal from '../components/RevertModal.astro';
import ContributionModal from '../components/ContributionModal.astro';
import AuthAlertModal from '../components/AuthAlertModal.astro';
import NodeViewer from '../components/NodeViewer.astro';

const GITHUB_TOKEN = import.meta.env.GITHUB_TOKEN;
const REPO_USER = "AnnacKK";
const REPO_NAME = "GAIA_BASIN_NOTES";
const REPO_BRANCH = "main";
const RAW_CDN_URL = `https://raw.githubusercontent.com/${REPO_USER}/${REPO_NAME}/${REPO_BRANCH}/`;

let processedNodes = [];
let processedLinks = [];
let folderTree = { id: 'root', label: 'Vault', children: [], files: [] };
let allResources = [];
let globalContributors = {};
let syncStatus = "Ready";

try {
  const headers = { "Accept": "application/vnd.github.v3+json", "Cache-Control": "no-cache" };
  if (GITHUB_TOKEN) headers["Authorization"] = `token ${GITHUB_TOKEN}`;

  const response = await fetch(`https://api.github.com/repos/${REPO_USER}/${REPO_NAME}/git/trees/${REPO_BRANCH}?recursive=1&t=${Date.now()}`, { headers });
  if (!response.ok) throw new Error(`API error: ${response.status}`);

  try {
     const contribRes = await fetch(`https://api.github.com/repos/${REPO_USER}/${REPO_NAME}/contents/contributors.json`, { headers });
     if (contribRes.ok) {
        const cData = await contribRes.json();
        globalContributors = JSON.parse(atob(cData.content.replace(/\n/g, '')));
     }
  } catch(e) {}

  const data = await response.json();
  const folderMap = new Map();

  const ensureFolder = (segments) => {
    let current = folderTree;
    let path = "";
    for (const segment of segments) {
      path = path ? `${path}/${segment}` : segment;
      if (!folderMap.has(path)) {
        const next = { id: path, label: segment, children: [], files: [] };
        folderMap.set(path, next);
        current.children.push(next);
      }
      current = folderMap.get(path);
    }
    return current;
  };

  let fileNodes = data.tree
    .filter(item => item.type === 'blob' && item.path.toLowerCase().endsWith('.md'))
    .map(item => {
      const segments = item.path.split('/');
      const fileName = segments.pop().replace(/\.md$/i, '');
      const parent = ensureFolder(segments);
      parent.files.push({ id: item.path, label: fileName, type: 'file' });
      return {
        id: item.path,
        label: fileName,
        isFolder: false,
        color: '#cbd5e1',
        shape: 'dot',
        size: 14,
        path: item.path
      };
    });

  const folderNodes = Array.from(folderMap.values()).map(folder => ({
    id: folder.id,
    label: folder.label,
    isFolder: true,
    color: '#f8fafc',
    shape: 'dot',
    size: 18,
    path: folder.id
  }));
 
  processedNodes = [
    { id: folderTree.id, label: folderTree.label, isFolder: true, color: '#f8fafc', shape: 'dot', size: 24, path: folderTree.id },
    ...folderNodes,
    ...fileNodes
  ];

  const buildLinks = (folder) => {
    for (const child of folder.children) {
      processedLinks.push({ from: folder.id, to: child.id });
      buildLinks(child);
    }
    for (const file of folder.files) {
      processedLinks.push({ from: folder.id, to: file.id });
    }
  };

  buildLinks(folderTree);

  const fetchPromises = fileNodes.map(async (file) => {
    try {
      const encodePath = file.path.split('/').map(encodeURIComponent).join('/');
      const res = await fetch(`${RAW_CDN_URL}${encodePath}?t=${Date.now()}`);
      if (!res.ok) return;
      const text = await res.text();
      const body = text.replace(/^---[\s\S]*?---\s*/, '');
      const lines = body.split(/\r?\n/);
      let currentRes = null;
      const cleanLine = (str) => str.replace(/^[\*\-\s]+/, '').trim();
      for (let line of lines) {
        const trimmed = line.trim();
        if (trimmed.startsWith('- type:') || trimmed.startsWith('* type:')) {
          if (currentRes && currentRes.author) allResources.push(currentRes);
          currentRes = { type: cleanLine(trimmed).replace('type:', '').trim(), fileId: file.id };
        } else if (currentRes) {
          if (trimmed.startsWith('title:')) currentRes.title = cleanLine(trimmed).replace('title:', '').replace(/["']/g, '').trim();
          if (trimmed.startsWith('url:')) currentRes.url = cleanLine(trimmed).replace('url:', '').replace(/["']/g, '').trim();
          if (trimmed.startsWith('author:')) currentRes.author = cleanLine(trimmed).replace('author:', '').replace(/["']/g, '').trim();
          if (trimmed.startsWith('incognito:')) currentRes.incognito = cleanLine(trimmed).replace('incognito:', '').replace(/["']/g, '').trim() === 'true';
        }
      }
      if (currentRes && currentRes.author) allResources.push(currentRes);
    } catch (e) {
    }
  });

  await Promise.all(fetchPromises);
} catch (e) {
  syncStatus = "Offline";
}

---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>GaiaBasin Garden</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <script src="https://cdn.jsdelivr.net/npm/vis-network@10.1.0/standalone/umd/vis-network.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/fuse.js@7.0.0"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>
    

      <style is:global>
      * {
        scrollbar-width: none !important;
        -ms-overflow-style: none !important;
      }
      *::-webkit-scrollbar {
        display: none !important;
      }
    </style>
  </head>
  <body>
    <div id="app-layout" class="grid h-screen grid-cols-[320px_1fr] bg-[#031226] transition-all duration-300">
      <aside id="left-sidebar" class="flex flex-col border-r border-[#0f1f42] bg-[#04112b] px-6 py-8 overflow-y-auto overflow-x-hidden custom-scrollbar transition-all duration-300 w-[320px]">
        
        <div class="mb-6 flex items-center gap-3">
          <div class="relative flex-1 group">
            <input type="text" id="vault-search" placeholder="Search notes..." class="w-full bg-[#051833] border border-[#14325a] rounded-xl py-2 pl-10 pr-10 text-sm text-slate-200 focus:outline-none focus:border-[#2b74b0] placeholder-slate-500" />
            <svg class="w-4 h-4 text-slate-500 absolute left-3 top-2.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
            <button id="clear-search-btn" class="absolute right-3 top-2.5 text-slate-500 hover:text-slate-300 hidden" title="Clear search" onclick="const input = document.getElementById('vault-search'); input.value=''; input.dispatchEvent(new Event('input'))">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
            </button>
          </div>
          <button onclick="window.toggleSidebar()" class="text-slate-400 hover:text-white transition-colors p-1 bg-[#0a1e3f] rounded-lg border border-[#14325a] hover:bg-[#12315e]" title="Close Sidebar">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 19l-7-7 7-7m8 14l-7-7 7-7"></path></svg>
          </button>
        </div>
        <div>
          <div id="vault-structure-container">
            <div class="flex items-center justify-between mb-4">
              <p class="text-[11px] uppercase tracking-[0.35em] text-[#7c98d9]">Graphs</p>
              <button onclick="window.fitGlobalGraph()" title="Zoom out and reset graph view" class="text-[10px] uppercase tracking-widest text-[#7c98d9] hover:text-white transition-colors duration-200 focus:outline-none bg-[#0a1e3f] hover:bg-[#12315e] border border-[#1a3866] px-2 py-1 rounded">Reset View</button>
            </div>
            <ul id="vault-structure" class="space-y-4 text-sm text-slate-200"></ul>
          </div>
          <div id="search-results-container" class="hidden">
            <p class="text-[11px] uppercase tracking-[0.35em] text-[#7c98d9] mb-4">Search Results</p>
            <ul id="search-results-list" class="space-y-2 text-sm text-slate-200"></ul>
          </div>
        </div>
        
        <div class="mt-auto pt-8 flex flex-col gap-4">
          <!-- Useful Researches Button -->
          <button onclick="window.openResearchesWindow()" class="flex items-center gap-3 text-sm text-[#8ecae6] hover:text-white transition-colors group px-0.5 mt-2">
            <svg class="w-4 h-4 opacity-70 group-hover:opacity-100" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"></path></svg>
            <span>Useful Researches</span>
          </button>
          
          <!-- Books Library Button -->
          <button onclick="window.openLibrary()" class="flex items-center gap-3 text-sm text-[#8ecae6] hover:text-white transition-colors group px-0.5">
            <svg class="w-4 h-4 opacity-70 group-hover:opacity-100" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path></svg>
            <span>Books Library</span>
          </button>

          <button onclick="document.getElementById('contribution-modal').classList.remove('hidden')" class="text-left text-[13px] font-medium text-slate-400 hover:text-[#8ecae6] transition-colors flex items-center gap-3">
             <svg class="w-4 h-4 opacity-70" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
             About Contribution
          </button>
          <a href="/about" class="text-left text-[13px] font-medium text-slate-400 hover:text-[#8ecae6] transition-colors flex items-center gap-3">
             <svg class="w-4 h-4 opacity-70" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>
             About Me
          </a>
        </div>
      </aside>

      <main class="relative overflow-hidden bg-[#04162c] flex-1">
        <div class="absolute top-6 left-6 z-50 flex items-center gap-4 pointer-events-none">
          <button id="open-sidebar-btn" onclick="window.toggleSidebar()" class="pointer-events-auto hidden bg-[#0d2a53] border border-[#2b4d7b] rounded-xl p-2.5 text-slate-300 hover:text-white hover:bg-[#1c4a82] shadow-lg transition-all" title="Open Sidebar">
             <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path></svg>
          </button>
          
          <!-- Live Graph Sync Status -->
          <div class="flex items-center gap-2.5 bg-[#0a1e3f]/80 backdrop-blur border border-[#14325a] px-4 py-2 rounded-xl shadow-lg pointer-events-auto">
            <span id="sync-status-dot" class="relative flex h-2 w-2 shrink-0">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-60"></span>
              <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
            </span>
            <div class="flex flex-col leading-none">
              <span class="text-[10px] font-semibold uppercase tracking-widest text-slate-400">Graph Sync</span>
              <span id="sync-status-time" class="text-[11px] text-slate-300 mt-0.5">Initializing…</span>
            </div>
          </div>
        </div>

        <div class="absolute right-6 top-6 z-20" id="auth-controls"></div>
        <div class="h-full w-full relative min-h-screen">
          <div id="graph-canvas" class="relative h-full w-full min-h-screen"></div>
          <!-- Live Graph Update Toast -->
          <div id="graph-sync-toast" class="hidden absolute bottom-24 left-1/2 -translate-x-1/2 z-50 flex items-center gap-2.5 bg-[#0a2336]/95 border border-[#1a4a7a] text-[#8ecae6] text-xs font-semibold px-5 py-2.5 rounded-full shadow-lg backdrop-blur-md transition-all duration-500 pointer-events-none">
            <svg class="w-3.5 h-3.5 text-emerald-400 animate-pulse" fill="currentColor" viewBox="0 0 20 20"><circle cx="10" cy="10" r="4"/></svg>
            <span id="graph-sync-toast-text">Graph updated with new content</span>
          </div>
          
          <!-- Bottom Centered Button Pill Group -->
          <div class="absolute bottom-8 left-1/2 -translate-x-1/2 z-30 flex items-center bg-[#05162a]/95 border border-[#14325a] rounded-full px-1.5 py-1.5 shadow-[0_12px_40px_rgba(0,0,0,0.6)] backdrop-blur-md">
            <button onclick="window.openAddNodeModal()" class="px-6 py-2.5 rounded-full text-sm font-semibold tracking-wider text-[#d5e9ff] hover:bg-[#12315e]/70 hover:text-white transition-all cursor-pointer">
              Add Node
            </button>
            <div class="h-6 w-px bg-[#14325a] mx-1"></div>
            <button onclick="window.openAddBranchModal()" class="px-6 py-2.5 rounded-full text-sm font-semibold tracking-wider text-[#d5e9ff] hover:bg-[#12315e]/70 hover:text-white transition-all cursor-pointer">
              Add Branch
            </button>
            <div class="h-6 w-px bg-[#14325a] mx-1"></div>
            <button onclick="window.openExportModal()" class="px-4 py-2.5 rounded-full text-sm font-semibold tracking-wider text-[#d5e9ff] hover:bg-[#12315e]/70 hover:text-white transition-all cursor-pointer flex items-center justify-center" title="Export Graph">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path></svg>
            </button>
          </div>
        </div>
      </main>
    </div>

    <!-- ─── Celebration Overlay ──────────────────────────────── -->
    <div id="celebrate-overlay" class="hidden fixed inset-0 z-[200] flex items-center justify-center pointer-events-none">
      <div id="celebrate-card" class="pointer-events-auto relative flex flex-col items-center gap-5 bg-[#040f20]/90 border border-[#1a4a7a]/60 backdrop-blur-xl rounded-3xl px-12 py-10 shadow-[0_0_80px_rgba(142,202,230,0.15)] text-center" style="animation: celebrate-pop 0.5s cubic-bezier(0.34,1.56,0.64,1) forwards; opacity:0;">
        <!-- Emoji salute burst -->
        <div style="animation: celebrate-float 2s ease-in-out infinite; font-size: 3.5rem; line-height:1;">🎉</div>
        <div>
          <p class="text-3xl font-extrabold text-white tracking-tight mb-1">Thank You!</p>
          <p class="text-base text-[#8ecae6] font-medium" id="celebrate-subtext">Your contribution is now under review.</p>
        </div>
        <div class="flex items-center gap-2 text-xs text-slate-400 bg-white/5 border border-white/10 rounded-full px-4 py-2">
          <svg class="w-3.5 h-3.5 text-emerald-400" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
          Pull request submitted to GitHub
        </div>
        <button onclick="window.closeCelebration()" class="mt-1 rounded-full bg-[#8ecae6]/10 hover:bg-[#8ecae6]/20 border border-[#8ecae6]/30 text-[#8ecae6] text-sm font-semibold px-8 py-2.5 transition-colors">Continue</button>
      </div>
    </div>

        <DeleteModal />


        <RevertModal />


        <ContributionModal />



        <AuthAlertModal />


        <NodeViewer />


        <EditorModal />


        <ResourceModal />

        <AddNodeModal />


        <ExportModal />


        <ResearchesWindow />


        <AddResearchModal />


        <AddBranchModal />


        <AccountModal />


            <LibraryWindow />


        <div id="add-book-modal" class="hidden fixed inset-0 z-[110] bg-black/80 p-6 overflow-auto flex items-center justify-center">
      <div class="mx-auto w-full max-w-xl rounded-[32px] border border-[#1e314e] bg-[#061525] shadow-2xl relative">
        <div class="flex flex-col gap-4 border-b border-[#17324b] px-6 py-5 md:flex-row md:items-center md:justify-between">
          <div>
            <p class="text-2xl font-semibold text-white">Add Book to Library</p>
            <p class="mt-1 text-sm text-slate-400">Upload a PDF book directly to the Hugging Face bucket.</p>
          </div>
          <button onclick="window.closeAddBookModal()" class="rounded-2xl border border-[#2b4d7b] bg-[#0d2a53] px-4 py-2 text-sm text-slate-100 hover:bg-[#1c4a82]">Cancel</button>
        </div>
        <form id="add-book-form" onsubmit="window.submitBookForm(event)" class="space-y-5 px-6 py-5">
          <div>
            <label class="block text-sm font-medium text-slate-300 mb-1.5">Book File (PDF)</label>
            <input type="file" id="book-file-input" accept="application/pdf" required class="w-full text-sm text-slate-400 file:mr-4 file:py-2.5 file:px-4 file:rounded-full file:border-0 file:text-xs file:font-semibold file:bg-[#0d2a53] file:text-sky-200 hover:file:bg-[#1c4a82] file:cursor-pointer" />
          </div>
          <div>
            <label class="block text-sm font-medium text-slate-300 mb-1.5">Book Title</label>
            <input id="book-title-input" type="text" required class="w-full rounded-2xl border border-[#1f2f4f] bg-[#071625] px-4 py-3 text-slate-100 focus:border-[#5c7aff] outline-none" placeholder="A More Just Future" />
          </div>
          <div>
            <label class="block text-sm font-medium text-slate-300 mb-1.5">Description</label>
            <textarea id="book-desc-input" rows="2" class="w-full rounded-2xl border border-[#1f2f4f] bg-[#071625] px-4 py-3 text-slate-100 focus:border-[#5c7aff] outline-none" placeholder="Enter book summary..."></textarea>
          </div>
          <div class="grid grid-cols-2 gap-4">
             <div>
               <label class="block text-sm font-medium text-slate-300 mb-1.5">Theme / Category</label>
               <input id="book-theme-input" type="text" required class="w-full rounded-2xl border border-[#1f2f4f] bg-[#071625] px-4 py-3 text-slate-100 focus:border-[#5c7aff] outline-none" placeholder="Programming" />
             </div>
             <div>
               <label class="block text-sm font-medium text-slate-300 mb-1.5">Difficulty Level</label>
               <select id="book-level-select" class="w-full rounded-2xl border border-[#1f2f4f] bg-[#071625] px-4 py-3 text-slate-100 focus:border-[#5c7aff] outline-none appearance-none cursor-pointer">
                 <option value="Easy">Easy</option>
                 <option value="Medium" selected>Medium</option>
                 <option value="Hard">Hard</option>
               </select>
             </div>
          </div>
          <div>
            <label class="block text-sm font-medium text-slate-300 mb-1.5">Tags (comma-separated)</label>
            <input id="book-tags-input" type="text" class="w-full rounded-2xl border border-[#1f2f4f] bg-[#071625] px-4 py-3 text-slate-100 focus:border-[#5c7aff] outline-none" placeholder="statistics, tutorial, oop" />
          </div>
          
          <div class="pt-2 border-t border-[#17324b] flex items-center justify-between">
            <p id="book-submit-status" class="text-sm text-slate-400"></p>
            <button type="submit" id="btn-submit-book" class="bg-[#1a4f7f] px-6 py-2.5 rounded-full font-semibold text-[#d5e9ff] hover:bg-[#2b74b0] disabled:opacity-50 disabled:cursor-not-allowed transition-colors">Add Book</button>
          </div>
        </form>
      </div>
    </div>

    
    <script is:inline define:vars={{ processedNodes, processedLinks, folderTree, RAW_CDN_URL, allResources, globalContributors }}>
      window.processedNodes = processedNodes;
      window.processedLinks = processedLinks;
      window.folderTree = folderTree;
      window.RAW_CDN_URL = RAW_CDN_URL;
      window.allResources = allResources;
      window.globalContributors = globalContributors;
      window.GAIA_DATA = { processedNodes, processedLinks, folderTree, RAW_CDN_URL, allResources, globalContributors };
    </script>
    <script>
      import '../scripts/main.js';
    </script>
  </body>
</html>
