           if (path) {
              cmdBox.value = `git clone https://github.com/AnnacKK/GAIA_BASIN_NOTES.git "${path}"`;
           } else {
              cmdBox.value = `git clone https://github.com/AnnacKK/GAIA_BASIN_NOTES.git`;
           }
