            const indexSpan = `<span class="line-sidebar__index">${String(index + 1).padStart(2, '0')} </span>`;
            if (item.type === 'section') {
              const indent = item.depth > 1 ? `padding-left: ${0.75 * (item.depth - 1)}rem;` : '';
