<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>GaiaBasin Garden</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <script src="https://cdn.jsdelivr.net/npm/vis-network@10.1.0/standalone/umd/vis-network.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/fuse.js@7.0.0"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
    <style>
      html, body { background-color: #071621; color: #e7edf8; margin: 0; padding: 0; min-height: 100%; }
      body { font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; }
      .sidebar-scroll { overflow-y: auto; }
      .graph-panel { min-height: 24rem; }
      #vault-structure { list-style: none; margin: 0; padding: 0; }
      #vault-structure li { list-style: none; }
      .folder-label { display: flex; align-items: center; justify-content: space-between; gap: 0.75rem; padding: 0.75rem 0.85rem; border-radius: 1.25rem; transition: background 0.2s, color 0.2s; cursor: pointer; }
      .folder-label:hover { background: rgba(255, 255, 255, 0.05); }
      .folder-arrow { transition: transform 0.2s ease; }
      .folder-open > .folder-label .folder-arrow { transform: rotate(90deg); }
      .file-item { display: block; padding: 0.6rem 0.85rem; color: #a8c2e8; border-radius: 1.1rem; transition: background 0.2s, color 0.2s; cursor: pointer; }
      .file-item:hover { background: rgba(255, 255, 255, 0.04); color: #ffffff; }
      .prose pre { white-space: pre-wrap; word-break: break-word; overflow-wrap: anywhere; overflow-x: hidden; }
      .prose code { background: rgba(148, 163, 184, 0.12); padding: 0.2rem 0.35rem; border-radius: 0.35rem; word-break: break-word; overflow-wrap: anywhere; }
      #graph-canvas { position: absolute; inset: 0;z-index: 1; background: radial-gradient(circle at 20% 20%, rgba(87, 155, 255, 0.14), transparent 20%), linear-gradient(135deg, rgba(10, 22, 46, 0.96), rgba(4, 15, 29, 0.96), rgba(4, 15, 29, 0.96)); }
      #node-viewer { overflow: hidden; padding: 0; }

      #node-viewer .viewer-shell { width: 100vw; height: 100vh; max-width: none; max-height: none; overflow: hidden; border-radius: 0; }
      #node-viewer .viewer-shell > .flex { padding: 1.5rem; }
      #node-viewer .viewer-grid { min-height: 0; height: calc(100vh - 10rem); overflow: hidden; display: grid; gap: 1rem; grid-template-columns: minmax(100px, 150px) minmax(0, 1fr) minmax(260px, 320px); }
      #reader-body { overflow: auto; min-height: 0; max-height: 100%; }
      #reader-sections button, #reader-sections a { display: block; text-align: left; width: 100%; }
      #reader-sections li { list-style: none; }
      #reader-sections .section-item { padding: 0.55rem 0.75rem; border-radius: 1rem; transition: background 0.2s; }
      #reader-sections .section-item:hover { background: rgba(255,255,255,0.05); }
      #mini-graph { position: relative; overflow: hidden; }
      #mini-graph canvas { width: 100% !important; height: 100% !important; }

      .nav-btn {
  display: block;
  width: 100%;
  text-align: left;
  padding: 0.75rem 1rem;
  border-radius: 1rem;
  color: #94a3b8;
  transition: all 0.2s;
}
.nav-btn:hover {
  background: rgba(255, 255, 255, 0.05);
  color: #ffffff;
}

.scrollbar-hide::-webkit-scrollbar { display: none; }
.scrollbar-hide { -ms-overflow-style: none; scrollbar-width: none; }

.custom-scrollbar::-webkit-scrollbar { width: 6px; height: 6px; }
.custom-scrollbar::-webkit-scrollbar-track { background: transparent; }
.custom-scrollbar::-webkit-scrollbar-thumb { background: #1b3e63; border-radius: 10px; }
.custom-scrollbar::-webkit-scrollbar-thumb:hover { background: #2b74b0; }
.custom-scrollbar { scrollbar-width: thin; scrollbar-color: #1b3e63 transparent; }
</style>
<style is:global>
.line-sidebar {
  --accent-color: #8ecae6;
  --text-color: #cbd5e1;
  --marker-color: #1e3a8a;
  --marker-length: 30px;
  --marker-gap: 8px;
  --tick-scale: 0.5;
  --max-shift: 10px;
  --item-gap: 6px;
  --font-size: 0.85rem;
  --smoothing: 150ms;

  position: relative;
  display: flex;
  justify-content: flex-start;
}

.line-sidebar--markers {
  padding-left: calc(var(--marker-length) + var(--marker-gap));
}

.line-sidebar--nested {
  padding-left: 20px;
  --marker-length: 12px;
}

.line-sidebar__list {
  list-style: none;
  margin: 0;
  padding: 0;
  display: flex;
  flex-direction: column;
  gap: var(--item-gap);
  width: 100%;
}

.line-sidebar__item {
  position: relative;
  cursor: pointer;
}

.line-sidebar__item::before {
  content: '';
  position: absolute;
  inset: -6px -48px;
  z-index: 1;
}

.line-sidebar__label {
  position: relative;
  display: flex;
  align-items: flex-start;
  font-size: var(--font-size);
  line-height: 1.2;
  color: color-mix(in srgb, var(--accent-color) calc(var(--effect, 0) * 100%), var(--text-color));
  transform: translateX(calc(var(--effect, 0) * var(--max-shift)));
  z-index: 2;
  transition: opacity 0.2s;
}

.line-sidebar__item:hover .line-sidebar__label {
  opacity: 1;
}

.line-sidebar__index {
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  margin-right: 0.6rem;
  font-size: 0.85em;
  opacity: calc(0.55 + var(--effect, 0) * 0.45);
  flex-shrink: 0;
  margin-top: 0.2rem;
}

.line-sidebar__text {
  flex: 1;
}

.line-sidebar__marker {
  position: absolute;
  top: 12px;
  left: calc(-1 * var(--marker-length) - var(--marker-gap));
  height: 2px;
  width: var(--marker-length);
  background-color: color-mix(in srgb, var(--accent-color) calc(var(--effect, 0) * 100%), var(--marker-color));
  transform-origin: left center;
  transform: translateY(-50%) scaleX(calc(0.5 + var(--effect, 0) * 0.5));
  z-index: 2;
  border-radius: 2px;
}

.line-sidebar--ticks .line-sidebar__item:not(:last-child)::after {
  content: '';
  position: absolute;
  top: 24px;
  left: calc(-1 * var(--marker-length) - var(--marker-gap));
  height: 2px;
  width: calc(var(--marker-length) * var(--tick-scale));
  background-color: var(--marker-color);
  opacity: 0.3;
  transform: translateY(-50%);
  border-radius: 2px;
}

.line-sidebar--scale-tick .line-sidebar__item:not(:last-child)::after {
  transform-origin: left center;
  transform: translateY(-50%) scaleX(calc(0.5 + var(--effect, 0) * 0.6));
}
</style>
  </head>
  <body>
    <div class="grid h-screen grid-cols-[320px_1fr] bg-[#031226]">
      <aside class="flex flex-col border-r border-[#0f1f42] bg-[#04112b] px-6 py-8 overflow-y-auto overflow-x-hidden custom-scrollbar">
        <div class="mb-6 relative">
          <input type="text" id="vault-search" placeholder="Search notes..." class="w-full bg-[#051833] border border-[#14325a] rounded-xl py-2 pl-10 pr-4 text-sm text-slate-200 focus:outline-none focus:border-[#2b74b0] placeholder-slate-500" />
          <svg class="w-4 h-4 text-slate-500 absolute left-3 top-2.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
        </div>
        <div>
          <div id="vault-structure-container">
            <div class="flex items-center justify-between mb-4">
              <p class="text-[11px] uppercase tracking-[0.35em] text-[#7c98d9]">Graphs</p>
              <button onclick="window.fitGlobalGraph()" title="Zoom out and reset graph view" class="text-[10px] uppercase tracking-widest text-[#7c98d9] hover:text-white transition-colors duration-200 focus:outline-none bg-[#0a1e3f] hover:bg-[#12315e] border border-[#1a3866] px-2 py-1 rounded">Reset View</button>
            </div>
            <ul id="vault-structure" class="space-y-4 text-sm text-slate-200"></ul>
          </div>
          <div id="search-results-container" class="hidden">
            <p class="text-[11px] uppercase tracking-[0.35em] text-[#7c98d9] mb-4">Search Results</p>
            <ul id="search-results-list" class="space-y-2 text-sm text-slate-200"></ul>
          </div>
        </div>
        
        <div class="mt-auto pt-8 flex flex-col gap-4">
          <button onclick="document.getElementById('contribution-modal').classList.remove('hidden')" class="text-left text-[13px] font-medium text-slate-400 hover:text-[#8ecae6] transition-colors flex items-center gap-3">
             <svg class="w-4 h-4 opacity-70" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
             About Contribution
          </button>
          <a href="/about" class="text-left text-[13px] font-medium text-slate-400 hover:text-[#8ecae6] transition-colors flex items-center gap-3">
             <svg class="w-4 h-4 opacity-70" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>
             About Me
          </a>
        </div>
      </aside>

      <main class="relative overflow-hidden bg-[#04162c]">
        <div class="absolute right-6 top-6 z-20" id="auth-controls"></div>
        <div class="h-full w-full relative min-h-screen">
          <div id="graph-canvas" class="relative h-full w-full min-h-screen"></div>
          
          <!-- Bottom Centered Button Pill Group -->
          <div class="absolute bottom-8 left-1/2 -translate-x-1/2 z-30 flex items-center bg-[#05162a]/95 border border-[#14325a] rounded-full px-1.5 py-1.5 shadow-[0_12px_40px_rgba(0,0,0,0.6)] backdrop-blur-md">
            <button onclick="window.openAddNodeModal()" class="px-6 py-2.5 rounded-full text-sm font-semibold tracking-wider text-[#d5e9ff] hover:bg-[#12315e]/70 hover:text-white transition-all cursor-pointer">
              Add Node
            </button>
            <div class="h-6 w-px bg-[#14325a] mx-1"></div>
            <button onclick="window.openAddBranchModal()" class="px-6 py-2.5 rounded-full text-sm font-semibold tracking-wider text-[#d5e9ff] hover:bg-[#12315e]/70 hover:text-white transition-all cursor-pointer">
              Add Branch
            </button>
          </div>
        </div>
      </main>
    </div>

    <div id="delete-modal" class="hidden fixed inset-0 z-[100] flex items-center justify-center bg-black/80 backdrop-blur-sm transition-opacity">
      <div class="w-full max-w-md rounded-2xl border border-[#1b2f4f] bg-[#051a33] p-6 shadow-2xl">
        <h3 class="text-lg font-semibold text-rose-400 mb-2">Delete Resource</h3>
        <p class="text-sm text-slate-300 mb-6">Are you sure you want to permanently delete "<span id="delete-modal-title" class="text-white font-medium"></span>"? This action cannot be undone and will immediately remove the resource from the global repository without requiring a Pull Request.</p>
        <div class="flex justify-end gap-3">
          <button onclick="window.closeDeleteModal()" class="rounded-xl px-4 py-2 text-sm font-medium text-slate-300 hover:bg-[#0f2c56] transition-colors">Cancel</button>
          <button id="confirm-delete-btn" class="rounded-xl bg-rose-600 px-4 py-2 text-sm font-medium text-white hover:bg-rose-500 transition-colors">Yes, Delete</button>
        </div>
      </div>
    </div>

    <div id="contribution-modal" class="hidden fixed inset-0 z-[100] flex items-center justify-center bg-black/80 backdrop-blur-sm transition-opacity">
      <div class="w-full max-w-2xl rounded-3xl border border-[#1b2f4f] bg-[#051a33] p-8 shadow-2xl overflow-y-auto max-h-[90vh] custom-scrollbar">
        <h3 class="text-2xl font-bold text-white mb-6 border-b border-[#1b2f4f] pb-4">About Contribution</h3>
        <div class="space-y-6 text-slate-300 text-sm leading-relaxed">
           <section>
              <h4 class="text-lg font-semibold text-[#8ecae6] mb-2">Terms of Contribution</h4>
              <p>By contributing to GaiaBasin Garden, you agree that your contributions will be licensed under the MIT License. You must only submit original work or work that you have the rights to share. We reserve the right to review, edit, or reject any submissions that do not meet our quality standards or code of conduct.</p>
           </section>
           <section>
              <h4 class="text-lg font-semibold text-[#8ecae6] mb-2">Mechanism (Pull Requests)</h4>
              <p>All contributions are managed via GitHub Pull Requests. When you create or edit a resource through this application, our backend automatically forks the repository, creates a new branch, commits your changes, and opens a Pull Request on your behalf. This ensures all changes undergo review before being merged into the global vault.</p>
           </section>
           <section>
              <h4 class="text-lg font-semibold text-[#8ecae6] mb-2">How to Contribute</h4>
              <ul class="list-disc pl-5 space-y-2 mt-2">
                 <li><strong>Login:</strong> You must be authenticated via GitHub to contribute.</li>
                 <li><strong>Adding Resources:</strong> Click the "Contribute" button while viewing a note to submit new articles, books, or courses to that topic.</li>
                 <li><strong>Editing Notes:</strong> Click the edit icon on a note to propose changes to its content.</li>
                 <li><strong>Review:</strong> After submission, you can track the status of your Pull Requests in your personal Account Dashboard.</li>
              </ul>
           </section>
        </div>
        <div class="mt-8 flex justify-end">
          <button onclick="document.getElementById('contribution-modal').classList.add('hidden')" class="rounded-xl bg-[#1a4f7f] px-6 py-2.5 text-sm font-semibold text-white hover:bg-[#2b74b0] transition-colors">Close</button>
        </div>
      </div>
    </div>


    <div id="auth-alert-modal" class="hidden fixed inset-0 z-[100] flex items-center justify-center bg-black/80 backdrop-blur-sm transition-opacity">
      <div class="w-full max-w-md rounded-2xl border border-[#1b2f4f] bg-[#051a33] p-6 shadow-2xl">
        <h3 class="text-lg font-semibold text-[#8ecae6] mb-2">Authentication Required</h3>
        <p id="auth-alert-message" class="text-sm text-slate-300 mb-6">You must be logged in to perform this action.</p>
        <div class="flex justify-end gap-3">
          <a href="/api/auth/login" class="rounded-xl bg-[#17548c] px-4 py-2 text-sm font-medium text-white hover:bg-[#1a66ab] transition-colors">Log In</a>
          <button onclick="document.getElementById('auth-alert-modal').classList.add('hidden')" class="rounded-xl px-4 py-2 text-sm font-medium text-slate-300 hover:bg-[#0f2c56] transition-colors">Close</button>
        </div>
      </div>
    </div>

    <div id="node-viewer" class="hidden fixed inset-0 z-50 bg-black/80 p-6">
