<div id="add-branch-modal" class="hidden fixed inset-0 z-60 bg-black/80 p-6 flex items-center justify-center">
      <div class="mx-auto w-full max-w-2xl rounded-[32px] border border-[#1e314e] bg-[#061525] shadow-2xl flex flex-col max-h-[90vh]">
        <div class="flex flex-col gap-4 border-b border-[#17324b] px-6 py-5 md:flex-row md:items-center md:justify-between shrink-0">
          <div>
            <p class="text-2xl font-semibold text-white">Add Branch (Upload Folders)</p>
            <p class="mt-1 text-sm text-slate-400">Propose a new branch structure by uploading a local folder.</p>
          </div>
        </div>
        <div class="space-y-4 px-6 py-5 overflow-y-auto flex-1 custom-scrollbar">
          <label class="block text-sm font-medium text-slate-300">Select Parent Location</label>
          <select id="new-branch-parent" class="w-full rounded-3xl border border-[#1f2f4f] bg-[#071625] px-4 py-3 text-slate-100 focus:border-[#5c7aff] outline-none appearance-none"></select>
          
          <label class="block text-sm font-medium text-slate-300">Upload Folder to Contribute</label>
          <input type="file" id="new-branch-upload" webkitdirectory directory multiple class="hidden" onchange="window.handleBranchFolderUpload(this)" />
          <div onclick="document.getElementById('new-branch-upload').click()" class="border-2 border-dashed border-[#1f2f4f] bg-[#071625] hover:border-[#5c7aff] transition-all rounded-3xl p-8 flex flex-col items-center justify-center gap-2 cursor-pointer group">
            <svg class="w-10 h-10 text-slate-500 group-hover:text-[#8ecae6] transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 9v3m0 0v3m0-3h3m-3 0H9m12 0a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
            <span class="text-sm text-slate-400 group-hover:text-slate-200 text-center" id="upload-box-text">Click to select a folder from your computer</span>
            <span class="text-xs text-slate-500">Only markdown (.md) files will be extracted</span>
          </div>

          <label class="block text-sm font-medium text-slate-300">Commit Message</label>
          <input id="new-branch-commit" type="text" class="w-full rounded-3xl border border-[#1f2f4f] bg-[#071625] px-4 py-3 text-slate-100 focus:border-[#5c7aff] outline-none" placeholder="Propose new folder branch structure" />
          
          <label class="block text-sm font-medium text-slate-300">Pull Request Description</label>
          <textarea id="new-branch-pr-desc" rows="2" class="w-full rounded-3xl border border-[#1f2f4f] bg-[#071625] px-4 py-3 text-slate-100 focus:border-[#5c7aff] outline-none" placeholder="Provide context about this new folder structure..."></textarea>
        </div>
        <div class="px-6 py-4 border-t border-[#17324b] shrink-0 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between bg-[#061525] rounded-b-[32px]">
          <p id="new-branch-status" class="text-sm text-slate-400"></p>
          <div class="flex items-center gap-3">
            <button onclick="window.submitNewBranch()" class="rounded-3xl bg-[#1a4f7f] px-5 py-2 text-base font-semibold text-[#d5e9ff] hover:bg-[#2b74b0]">Submit Branch</button>
            <button onclick="window.closeAddBranchModal()" class="rounded-3xl border border-[#2b4d7b] bg-[#0d2a53] px-5 py-2 text-base font-semibold text-slate-100 hover:bg-[#1c4a82]">Close</button>
          </div>
        </div>
      </div>
    </div>