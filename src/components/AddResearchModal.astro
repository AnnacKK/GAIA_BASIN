<div id="add-research-modal" class="hidden fixed inset-0 z-[110] bg-black/80 p-6 flex items-center justify-center">
      <div class="mx-auto w-full max-w-xl rounded-[32px] border border-[#1e314e] bg-[#061525] shadow-2xl flex flex-col max-h-[90vh]">
        <div class="flex flex-col gap-4 border-b border-[#17324b] px-6 py-5 md:flex-row md:items-center md:justify-between shrink-0">
          <div>
            <p class="text-2xl font-semibold text-white">Add Research Link</p>
            <p class="mt-1 text-sm text-slate-400">Share a useful article, tool, or paper.</p>
          </div>
        </div>
        <div class="space-y-5 px-6 py-5 overflow-y-auto flex-1 custom-scrollbar">
          <div>
            <label class="block text-sm font-medium text-slate-300 mb-1.5">Resource URL</label>
            <div class="flex gap-3">
              <input id="research-url-input" type="url" class="flex-1 rounded-2xl border border-[#1f2f4f] bg-[#071625] px-4 py-3 text-slate-100 focus:border-[#5c7aff] outline-none" placeholder="https://..." />
              <button onclick="window.previewResearchLink()" id="btn-preview-research" class="bg-[#2b74b0] hover:bg-[#348bd2] text-white px-5 rounded-2xl font-semibold text-sm transition-colors">Preview</button>
            </div>
          </div>
          
          <div>
            <label class="block text-sm font-medium text-slate-300 mb-1.5">Section / Category</label>
            <select id="research-category-select" class="w-full rounded-2xl border border-[#1f2f4f] bg-[#071625] px-4 py-3 text-slate-100 focus:border-[#5c7aff] outline-none appearance-none cursor-pointer">
              <option value="roadmaps">Roadmaps</option>
              <option value="leetcode style">LeetCode Style</option>
              <option value="best blog selections">Best Blog Selections</option>
            </select>
          </div>
          
          <div>
            <label class="block text-sm font-medium text-slate-300 mb-1.5">Tags (comma-separated)</label>
            <input id="research-tags-input" type="text" class="w-full rounded-2xl border border-[#1f2f4f] bg-[#071625] px-4 py-3 text-slate-100 focus:border-[#5c7aff] outline-none" placeholder="programming, leetcode, tutorial" />
          </div>
          
          <div id="research-preview-card" class="hidden border border-[#14325a] bg-[#05111d] rounded-2xl overflow-hidden relative">
            <div id="research-preview-image" class="h-40 w-full bg-cover bg-center bg-[#0a1e3f] border-b border-[#14325a]"></div>
            <div class="p-4">
              <h4 id="research-preview-title" class="font-bold text-[#d5e9ff] line-clamp-1"></h4>
              <p id="research-preview-desc" class="text-xs text-slate-400 mt-1 line-clamp-2"></p>
            </div>
          </div>
        </div>
        <div class="px-6 py-4 border-t border-[#17324b] shrink-0 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between bg-[#061525] rounded-b-[32px]">
          <p id="research-submit-status" class="text-sm text-amber-400"></p>
          <div class="flex items-center gap-3">
            <button id="btn-submit-research" onclick="window.submitResearchLink()" disabled class="bg-[#1a4f7f] px-5 py-2 rounded-full font-semibold text-base text-[#d5e9ff] hover:bg-[#2b74b0] disabled:opacity-50 disabled:cursor-not-allowed transition-colors">Submit PR</button>
            <button onclick="window.closeAddResearchModal()" class="rounded-3xl border border-[#2b4d7b] bg-[#0d2a53] px-5 py-2 text-base font-semibold text-slate-100 hover:bg-[#1c4a82]">Close</button>
          </div>
        </div>
      </div>
    </div>